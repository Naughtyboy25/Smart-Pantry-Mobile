<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for night mode (Material Design 2 - compatible). -->
    <style name="Theme.SmartPantry" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Error -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/error_container</item>

        <!-- Surface & Background -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Outline -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline_variant</item>

        <!-- Status bar / Navigation -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Elevation overlay for dark theme -->
        <item name="elevationOverlayEnabled">true</item>

        <!-- Typography (MD2 compatible) -->
        <item name="textAppearanceHeadline1">@style/TextAppearance.SmartPantry.Headline1</item>
        <item name="textAppearanceHeadline2">@style/TextAppearance.SmartPantry.Headline2</item>
        <item name="textAppearanceHeadline3">@style/TextAppearance.SmartPantry.Headline3</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.SmartPantry.Headline4</item>
        <item name="textAppearanceHeadline5">@style/TextAppearance.SmartPantry.Headline5</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.SmartPantry.Headline6</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.SmartPantry.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.SmartPantry.Subtitle2</item>
        <item name="textAppearanceBody1">@style/TextAppearance.SmartPantry.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.SmartPantry.Body2</item>
        <item name="textAppearanceCaption">@style/TextAppearance.SmartPantry.Caption</item>
        <item name="textAppearanceButton">@style/TextAppearance.SmartPantry.Button</item>
        <item name="textAppearanceOverline">@style/TextAppearance.SmartPantry.Overline</item>

        <!-- Shape -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.SmartPantry.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.SmartPantry.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.SmartPantry.LargeComponent</item>

        <!-- TextInputLayout default style -->
        <item name="textInputStyle">@style/Widget.SmartPantry.TextInputLayout</item>

        <!-- MaterialDatePicker theming (must be a ThemeOverlay, not a Dialog theme) -->
        <item name="materialCalendarTheme">@style/ThemeOverlay.SmartPantry.DatePicker</item>
    </style>
</resources>