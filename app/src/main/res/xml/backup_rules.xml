<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include SharedPreferences (user settings: expiry alerts, unit system) -->
    <include domain="sharedpref" path="."/>

    <!-- Include database files (pantry items, seeded recipes) -->
    <include domain="database" path="."/>

    <!-- Exclude Room's internal journal/WAL files (recreated on restore) -->
    <exclude domain="database" path="smart_pantry.db-wal"/>
    <exclude domain="database" path="smart_pantry.db-shm"/>

    <!-- Exclude cache files -->
    <exclude domain="file" path="cache/"/>
</full-backup-content>