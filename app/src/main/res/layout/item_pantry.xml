<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    app:cardElevation="1dp"
    app:cardMaxElevation="3dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/surface"
    app:cardUseCompatPadding="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@android:color/transparent">

        <!-- Ingredient Category Icon -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvItemIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivItemIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ingredient_default"
                android:tint="@color/text_secondary"
                android:contentDescription="@string/ingredient_icon_desc" />
        </androidx.cardview.widget.CardView>

        <!-- Item Name -->
        <TextView
            android:id="@+id/tvItemName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ingredient Name"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/cvItemIcon"
            app:layout_constraintEnd_toStartOf="@id/tvQuantityUnit" />

        <!-- Quantity Badge -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvQuantityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:minWidth="56dp"
            app:cardBackgroundColor="@color/primary_container"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivEditIndicator">

            <TextView
                android:id="@+id/tvQuantityUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="5 pcs"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/on_primary_container"
                android:fontFamily="sans-serif-medium"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>

        <!-- Expiry Date -->
        <TextView
            android:id="@+id/tvExpiry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Expires: 2024-12-31"
            android:textSize="12sp"
            android:textColor="@color/warning"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tvItemName"
            app:layout_constraintStart_toEndOf="@id/cvItemIcon"
            app:layout_constraintEnd_toStartOf="@id/ivEditIndicator"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Edit Indicator -->
        <ImageView
            android:id="@+id/ivEditIndicator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/text_disabled"
            android:contentDescription="@string/edit_item"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>